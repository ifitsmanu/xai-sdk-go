# Copy to .env and fill in. .env is gitignored; make loads it for live, ui, chat, and agent.

# Inference key from https://console.x.ai. Required for any API call.
XAI_API_KEY=

# Management key for collections, billing, audit, and team keys. Optional.
XAI_MANAGEMENT_API_KEY=

# Voice model ids are documented at https://docs.x.ai but not listed by any API.
# make live runs the realtime and transcription checks only when these are set.
XAI_LIVE_VOICE_MODEL=
XAI_LIVE_STT_MODEL=

# Terminal UI logging: a file path for debug logs, and 1 to include request bodies.
XAI_LOG=
XAI_LOG_BODY=
